{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "app.py",
                    "model.pkl",
                    "model_metrics.json",
                    "feature_importance.json",
                    "confusion_matrix.json",
                    "templates/**",
                    "static/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/api/index"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index"
        }
    ]
}